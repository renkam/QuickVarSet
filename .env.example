# Optional test configuration. Copy this file to .env and edit as needed.

# Default: $HOME/apps
APPS_DIR="$HOME/apps"

# FreeCAD_ matches AppImages such as FreeCAD_1.1.1-Linux-x86_64-py311.AppImage.
FREECAD_BIN_PATTERN="FreeCAD_"

# Default: .test/freecad inside this project.
FREECAD_TEST_DIR=".test/freecad"

# Optional exact AppImage override. This bypasses version discovery.
# FREECAD_APPIMAGE="$HOME/apps/FreeCAD_1.1.1-Linux-x86_64-py311.AppImage"